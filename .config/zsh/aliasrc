#Git
if [ ! -f "$HOME/.gitconfig" ]; then
	touch "$HOME/.gitconfig"
fi
if ! cat "$HOME/.gitconfig" | grep -q "lg ="; then
	git config --global --add alias.lg log\ --color\ --graph\ --all\ --oneline\ --pretty=format:\"%C\(auto\)%h%d\ %s\ %Cgreen%cr\"
fi
